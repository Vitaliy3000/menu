{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "description": "Обычный рецепт: универсальное описание блюда на N порций. Самостоятельная сущность, ничего не знает о техкартах (CookPlan).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "category",
    "tags",
    "difficulty",
    "servings",
    "time",
    "nutrition",
    "ingredients",
    "steps",
    "seasonality",
    "storage",
    "freezing",
    "reheating"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Путь к схеме для подсказок в редакторе. На сайт не влияет."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80,
      "description": "Уникальный идентификатор и часть URL. Должен совпадать с именем файла без .json."
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "Название блюда."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Короткое описание: чем блюдо хорошо, какое оно на вкус. 1–3 предложения."
    },
    "category": {
      "$ref": "#/$defs/RecipeCategory"
    },
    "cuisine": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Кухня, например «итальянская» или «домашняя»."
    },
    "diet": {
      "type": "array",
      "description": "Диетические свойства. Используются в фильтрах каталога.",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Diet"
      }
    },
    "tags": {
      "type": "array",
      "description": "Свободные теги в нижнем регистре: «одна сковорода», «на неделю», «для гостей».",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[^A-ZА-ЯЁ]+$"
      }
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "servings": {
      "$ref": "#/$defs/Servings"
    },
    "time": {
      "$ref": "#/$defs/RecipeTime"
    },
    "nutrition": {
      "$ref": "#/$defs/Nutrition"
    },
    "equipment": {
      "type": "array",
      "description": "Нужная посуда и техника.",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "ingredients": {
      "type": "array",
      "description": "Ингредиенты, сгруппированные по смыслу («Для соуса», «Для подачи»). Для простых рецептов — одна группа без названия.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/IngredientGroup"
      }
    },
    "steps": {
      "type": "array",
      "description": "Шаги приготовления, сгруппированные по этапам. Для простых рецептов — одна группа без названия.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/StepGroup"
      }
    },
    "tips": {
      "type": "array",
      "description": "Советы, замены и типичные ошибки.",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "seasonality": {
      "$ref": "#/$defs/Seasonality"
    },
    "storage": {
      "$ref": "#/$defs/Storage"
    },
    "freezing": {
      "$ref": "#/$defs/Freezing"
    },
    "reheating": {
      "$ref": "#/$defs/Reheating"
    },
    "image": {
      "$ref": "#/$defs/Image"
    },
    "source": {
      "$ref": "#/$defs/Source"
    }
  },
  "$defs": {
    "RecipeCategory": {
      "title": "RecipeCategory",
      "description": "Раздел меню.",
      "type": "string",
      "enum": [
        "breakfast",
        "soup",
        "salad",
        "main",
        "side",
        "pasta",
        "baking",
        "dessert",
        "snack",
        "sauce",
        "drink"
      ]
    },
    "Diet": {
      "title": "Diet",
      "type": "string",
      "enum": [
        "vegetarian",
        "vegan",
        "pescatarian",
        "gluten-free",
        "dairy-free"
      ]
    },
    "Difficulty": {
      "title": "Difficulty",
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "Servings": {
      "title": "Servings",
      "description": "Сколько порций получается из указанных количеств.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Количество порций."
        },
        "yield": {
          "type": "string",
          "maxLength": 60,
          "description": "Выход в натуральных единицах, если полезно: «≈ 2,5 л», «12 сырников»."
        }
      }
    },
    "RecipeTime": {
      "title": "RecipeTime",
      "description": "Время в минутах.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "total"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "description": "Активное время: когда руки заняты."
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "description": "Полное время от начала до подачи, включая ожидание."
        },
        "note": {
          "type": "string",
          "maxLength": 80,
          "description": "Что не входит в total: «+ ночь маринования»."
        }
      }
    },
    "Nutrition": {
      "title": "Nutrition",
      "description": "Пищевая ценность одной порции (приблизительно).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kcal",
        "protein",
        "fat",
        "carbs"
      ],
      "properties": {
        "kcal": {
          "type": "number",
          "minimum": 0,
          "description": "Калории, ккал."
        },
        "protein": {
          "type": "number",
          "minimum": 0,
          "description": "Белки, г."
        },
        "fat": {
          "type": "number",
          "minimum": 0,
          "description": "Жиры, г."
        },
        "carbs": {
          "type": "number",
          "minimum": 0,
          "description": "Углеводы, г."
        },
        "fiber": {
          "type": "number",
          "minimum": 0,
          "description": "Клетчатка, г."
        }
      }
    },
    "Unit": {
      "title": "Unit",
      "description": "Единица измерения. Отображается по-русски: g → г, tbsp → ст. л., clove → зубчик и т. д.",
      "type": "string",
      "enum": [
        "g",
        "kg",
        "ml",
        "l",
        "pcs",
        "tsp",
        "tbsp",
        "cup",
        "pinch",
        "clove",
        "bunch",
        "can",
        "slice",
        "sprig",
        "leaf",
        "pack",
        "handful"
      ]
    },
    "Ingredient": {
      "title": "Ingredient",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Название продукта: «Помидоры в собственном соку»."
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Количество. Если не задано — «по вкусу» (при toTaste) или без количества."
        },
        "amountMax": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Верхняя граница диапазона: amount=2, amountMax=3 → «2–3»."
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "note": {
          "type": "string",
          "maxLength": 80,
          "description": "Уточнение: «мелко нарезать», «комнатной температуры»."
        },
        "optional": {
          "type": "boolean",
          "description": "Можно не добавлять."
        },
        "toTaste": {
          "type": "boolean",
          "description": "Количество по вкусу."
        }
      },
      "dependentRequired": {
        "amountMax": [
          "amount"
        ],
        "unit": [
          "amount"
        ]
      }
    },
    "IngredientGroup": {
      "title": "IngredientGroup",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 40,
          "description": "Название группы: «Для соуса». Не нужно, если группа одна."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Ingredient"
          }
        }
      }
    },
    "Step": {
      "title": "Step",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 5,
          "description": "Что сделать. Одно действие или короткая связка действий."
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Сколько длится шаг, минут."
        },
        "tip": {
          "type": "string",
          "minLength": 5,
          "description": "Подсказка к шагу: признак готовности, частая ошибка."
        }
      }
    },
    "StepGroup": {
      "title": "StepGroup",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 40,
          "description": "Название этапа: «Соус», «Сборка». Не нужно, если этап один."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      }
    },
    "Seasonality": {
      "title": "Seasonality",
      "description": "Когда блюдо уместнее всего. Все 12 месяцев = круглый год.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "months"
      ],
      "properties": {
        "months": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "description": "Номера месяцев, 1 = январь."
        },
        "note": {
          "type": "string",
          "maxLength": 160,
          "description": "Почему именно эти месяцы, чем заменить вне сезона."
        }
      }
    },
    "Storage": {
      "title": "Storage",
      "description": "Хранение готового блюда.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fridgeDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Сколько дней хранится в холодильнике. 0 — лучше съесть сразу."
        },
        "roomDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365,
          "description": "Сколько дней хранится при комнатной температуре (выпечка, гранола)."
        },
        "container": {
          "type": "string",
          "maxLength": 80,
          "description": "В чём хранить."
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "Freezing": {
      "title": "Freezing",
      "description": "Можно ли замораживать готовое блюдо.",
      "oneOf": [
        {
          "title": "FreezingSuitable",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suitable",
            "months",
            "how",
            "thawing"
          ],
          "properties": {
            "suitable": {
              "const": true
            },
            "months": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Срок хранения в морозилке, месяцев."
            },
            "how": {
              "type": "string",
              "minLength": 5,
              "description": "Как замораживать: остудить, порционировать, тара."
            },
            "thawing": {
              "type": "string",
              "minLength": 5,
              "description": "Как размораживать."
            }
          }
        },
        {
          "title": "FreezingUnsuitable",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suitable",
            "note"
          ],
          "properties": {
            "suitable": {
              "const": false
            },
            "note": {
              "type": "string",
              "minLength": 5,
              "description": "Почему не стоит замораживать."
            }
          }
        }
      ]
    },
    "ReheatMethod": {
      "title": "ReheatMethod",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "instructions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "stovetop",
            "microwave",
            "oven",
            "airfryer",
            "steam"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 5
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "Reheating": {
      "title": "Reheating",
      "description": "Как разогревать. Пустой methods + note — для холодных блюд.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReheatMethod"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "Image": {
      "title": "Image",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "description": "Путь относительно public/ (images/borsch.jpg) или абсолютный https-URL."
        },
        "alt": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "Source": {
      "title": "Source",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
