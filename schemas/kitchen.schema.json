{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kitchen",
  "description": "Справочник кухни: кто что не ест, правила составления техкарт, оборудование и места хранения. На него опираются при составлении техкарт (CookPlan) вне сайта — чтобы не повторять всё это в каждом промпте. Техкарты на справочник не ссылаются и остаются самодостаточными.",
  "type": "object",
  "additionalProperties": false,
  "required": ["people", "equipment", "storage"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Путь к схеме для подсказок в редакторе. На сайт не влияет."
    },
    "draft": {
      "type": "boolean",
      "description": "true — данные-пример, сайт покажет пометку «черновик»."
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "description": "Для кого готовим и что каждый не ест.",
      "items": { "$ref": "#/$defs/Person" }
    },
    "planRules": {
      "type": "array",
      "description": "Правила составления техкарт по темам: продукты, питание, приёмы пищи, время и техника, фасовка.",
      "items": { "$ref": "#/$defs/RuleGroup" }
    },
    "equipment": {
      "type": "array",
      "description": "Техника и многоразовая посуда, которые есть на кухне.",
      "items": { "$ref": "#/$defs/KitchenEquipment" }
    },
    "storage": {
      "type": "array",
      "description": "Где храним готовое и сколько там места.",
      "items": { "$ref": "#/$defs/StoragePlace" }
    }
  },
  "$defs": {
    "LocalId": {
      "title": "LocalId",
      "description": "Идентификатор внутри справочника.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 40
    },
    "AvoidLevel": {
      "title": "AvoidLevel",
      "description": "allergy — аллергия, нельзя даже следов; never — не ест совсем; dislike — не любит, лучше обойтись или подать отдельно.",
      "type": "string",
      "enum": ["allergy", "never", "dislike"]
    },
    "AvoidItem": {
      "title": "AvoidItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "level"],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Продукт или группа продуктов: «Кинза», «Субпродукты»."
        },
        "level": { "$ref": "#/$defs/AvoidLevel" },
        "note": {
          "type": "string",
          "maxLength": 160,
          "description": "Чем заменить, в каком виде всё-таки можно."
        }
      }
    },
    "Person": {
      "title": "Person",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "avoid"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 40 },
        "avoid": {
          "type": "array",
          "items": { "$ref": "#/$defs/AvoidItem" }
        }
      }
    },
    "RuleGroup": {
      "title": "RuleGroup",
      "description": "Группа правил на одну тему.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rules"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Тема: «Питание», «Время и техника»."
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "description": "Правила — по одному на строку.",
          "items": { "type": "string", "minLength": 5, "maxLength": 240 }
        }
      }
    },
    "EquipmentKind": {
      "title": "EquipmentKind",
      "type": "string",
      "enum": ["oven", "hob", "appliance", "cookware", "tool", "container"]
    },
    "KitchenEquipment": {
      "title": "KitchenEquipment",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "kind": { "$ref": "#/$defs/EquipmentKind" },
        "count": { "type": "integer", "minimum": 1 },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "Характеристики: «60 л, конвекция, 2 уровня», «Ø 28 см»."
        },
        "note": {
          "type": "string",
          "maxLength": 160,
          "description": "Ограничения и особенности: «только посуда с магнитным дном»."
        }
      }
    },
    "StorageKind": {
      "title": "StorageKind",
      "type": "string",
      "enum": ["fridge", "freezer", "pantry"]
    },
    "StoragePlace": {
      "title": "StoragePlace",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "kind": { "$ref": "#/$defs/StorageKind" },
        "capacity": {
          "type": "string",
          "maxLength": 80,
          "description": "Объём и устройство: «≈ 60 л, 3 ящика»."
        },
        "free": {
          "type": "string",
          "maxLength": 100,
          "description": "Сколько обычно свободно под заготовки."
        },
        "note": { "type": "string", "maxLength": 160 }
      }
    }
  }
}
