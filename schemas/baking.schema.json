{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baking",
  "description": "Справочник раздела «Выпечка»: руководства (например, по формовому хлебу), что купить для домашней пекарни и что испечь дальше. Рецептуры (Bake) на него не ссылаются.",
  "type": "object",
  "additionalProperties": false,
  "required": ["guides", "shopping"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Путь к схеме для подсказок в редакторе. На сайт не влияет."
    },
    "guides": {
      "type": "array",
      "description": "Руководства: каждое — отдельный раздел страницы «Выпечка».",
      "items": { "$ref": "#/$defs/Guide" }
    },
    "shopping": {
      "type": "array",
      "description": "Что купить: инвентарь, мука и продукты, сгруппированные по смыслу.",
      "items": { "$ref": "#/$defs/ShoppingGroup" }
    },
    "ideas": {
      "type": "array",
      "description": "Что испечь дальше: идеи и ссылки, по которым ещё нет рецептуры.",
      "items": { "$ref": "#/$defs/Idea" }
    }
  },
  "$defs": {
    "Guide": {
      "title": "Guide",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "sections"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Уникальный идентификатор — якорь раздела на странице."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "О чём руководство, одно-два предложения."
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/GuideSection" }
        }
      }
    },
    "GuideSection": {
      "title": "GuideSection",
      "type": "object",
      "additionalProperties": false,
      "description": "Раздел руководства. Нужен вводный текст, пункты или и то и другое.",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "text": {
          "type": "string",
          "minLength": 5,
          "description": "Вводный абзац."
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "description": "Пункты: строка или пункт с заголовком, текстом и подпунктами.",
          "items": { "$ref": "#/$defs/GuidePoint" }
        }
      }
    },
    "GuidePoint": {
      "title": "GuidePoint",
      "oneOf": [
        { "type": "string", "minLength": 3 },
        {
          "title": "GuidePointDetail",
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 2, "maxLength": 60 },
            "text": { "type": "string", "minLength": 5 },
            "points": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 3 }
            }
          }
        }
      ]
    },
    "ShoppingGroup": {
      "title": "ShoppingGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "note": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ShoppingItem" }
        }
      }
    },
    "ShoppingItem": {
      "title": "ShoppingItem",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Что купить. Не повторяется внутри справочника."
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Размер, зачем нужно, на что обратить внимание."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "description": "Взаимозаменяемые варианты: «гастроёмкость GN 1/1», «baking cloche».",
          "items": { "type": "string", "minLength": 2, "maxLength": 100 }
        }
      }
    },
    "Idea": {
      "title": "Idea",
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 2, "maxLength": 60 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
