    {
      "title": "Овощи и мясо",
      "steps": [
        {
          "text": "Нарежьте и обжарьте выбранные овощи."
        },
        {
          "text": "Нарежьте и обжарьте мясо или креветки."
        }
      ]
    },
    {
      "title": "Сборка",
      "steps": [
        {
          "text": "Добавьте к лапше выбранный соус и соевый соус и жарьте на слабом огне 2–3 минуты.",
          "minutes": 3
        },
        {
          "text": "Добавьте мясо и овощи, по желанию — чеснок и кунжут, и прогрейте всё вместе.",
          "tip": "С фунчозой добавьте немного воды — так овощи легче вмешать в лапшу."
        }
      ]
    }
