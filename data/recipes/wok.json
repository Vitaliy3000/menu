  "steps": [
    {
      "title": "Лапша",
      "steps": [
        {
          "text": "Фунчоза: замочите её в тёплой воде на 30 минут.",
          "minutes": 30
        },
        {
          "text": "Обжарьте фунчозу на слабом огне 3 минуты.",
          "minutes": 3
        },
        {
          "text": "Соба или удон: отварите лапшу, не доводя до полной готовности, и обжарьте на слабом огне."
