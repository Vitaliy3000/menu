  "steps": [
    {
      "title": "Бульон",
      "steps": [
        {
          "text": "Поставьте кастрюлю на огонь и налейте немного масла. Крупно нарежьте одну морковь и одну луковицу и обжарьте их.",
          "minutes": 7
        },
        {
          "text": "Добавьте кетчуп и перемешайте.",
          "minutes": 1
        },
        {
          "text": "Выложите головы и хвосты форели, добавьте лавровый лист и душистый перец. Залейте водой и посолите.",
          "minutes": 10
        },
        {
          "text": "Варите бульон 20–30 минут.",
          "minutes": 30
        },
        {
          "text": "Процедите бульон и верните его в кастрюлю на огонь.",
          "minutes": 3
        }
      ]
    },
    {
      "title": "Суп",
      "steps": [
        {
          "text": "Нарежьте картофель, вторую морковь и вторую луковицу.",
          "minutes": 5
        },
        {
          "text": "Заложите картофель, морковь и лук в бульон и варите, пока картофель не станет мягким.",
          "minutes": 15
        },
        {
          "text": "Перед подачей посыпьте уху зеленью.",
          "minutes": 1
        }
      ]
    }
  ],
